#!name=国内常用网站与 App 去广告
#!desc=适用于国内常用网站与 App 的 Surge 去广告模块。精简 Ultra 并整合 B站开屏、首页与暂停去广告，剔除改区、网站跳转、解锁等附加规则。
#!category=去广告
#!version=2026.10.11.2
#!homepage=https://github.com/Imyukehan/surge-adblock
#!author=Imyukehan; upstream: Biliverse, yfamilys, ddgksf2013, app2smile, blackmatrix7, deezertidal
# B站处理基于 Biliverse ADBlock 0.7.3，仅保留开屏与首页广告过滤。
# 基础规则精简自 https://yfamilys.com/module/adultra.sgmodule (2026-10-10)。
# 脚本从原作者地址加载，来源与内容校验值见仓库 sources.json。
# 不处理起点奖励广告；不包含通用广告联盟域名封锁。
# Mac 使用 Maipo 时，可单独排除 api.weibo.com 的 MITM。

[URL Rewrite]
^https?://app\.58\.com/api/home/(advertising|appadv)/ _ reject
^https?://app\.58\.com/api/home/invite/popupAdv _ reject
^https?://pan\.baidu\.com/rest/\d\.\d/pcs/ad _ reject
^https?://issuecdn\.baidupcs\.com/issue/netdisk/guanggao _ reject
^https?://c\.tieba\.baidu\.com/c/f/forum/getAdInfo _ reject
^https?://app\.api\.ke\.com/config/config/bootpage _ reject
^https?://m\.ctrip\.com/restapi/[\w/]+tripAds _ reject
^https?://api\.m\.jd\.com/client\.action\?functionId=(start|queryMaterialAdverts) _ reject
^https?://(bdsp-x|dsp-x)\.jd\.com/adx/ _ reject
^https?://api\.m\.mi\.com/v\d/app/start _ reject
^https?://wmapi\.meituan\.com/api/v\d/startpicture _ reject
^https?://flowplus\.meituan\.net/v\d/\w+/linglong/\d+\.(gif|jpg|mp4) _ reject
^https?://api\.(pinduoduo|yangkeduo)\.com/api/cappuccino/splash _ reject
^https?://api\.smzdm\.com/v\d/util/loading _ reject
^https?://s\d\.zdmimg\.com/www/api/v\d/api/thirdAd\.php _ reject
^https?://api\.m\.jd\.com/client\.action\?functionId=home_launchConfig _ reject
^https?://mbasecc\.bas\.cmbchina\.com/Edge/api/mlife\.clientface\.clientservice\.api\.advertiseService/preCacheAdvertiseSec _ reject
^https?://api\.zhihu\.com/fringe/ad _ reject
^https?://api\.zhihu\.com/ad _ reject
^https?://api\.zhihu\.com/\w+/\d+/comments/featured-comment-ad _ reject
^https?:\/\/p0\.pipi\.cn\/mediaplus\/maoyantong_ads_fe\/(0fa3345c|2erwqe2f)\w+.jpg\?imageMogr2\/quality\/85 _ reject
^https?:\/\/m\.mynj\.cn:\d+\/znmh_FEP\/loadpic\.jsp.*ad_pic.*open _ reject
^https?:\/\/(preload-click|preload-impression)\.uve\.weibo\.com\/(interface\/wbpullad\/wbpullad_click\.php|wbapplua\/get_wbpullad_log\.lua) _ reject
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkconfig\.php _ reject

