^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen data-type=text data="" status-code=200
^https?:\/\/api\.weibo\.cn\/\d\/ad\/preload data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/boot.*weibo\.com\/v\d\/ad\/realtime data-type=text data="" status-code=200
^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash(?:\?|$) data-type=text data="" status-code=200
^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/(tag\/)?ads data-type=text data="" status-code=200

[Body Rewrite]
# Biliverse 0.7.3 未处理开屏 data.list；先清空列表，再交给原脚本处理其他字段。
http-response-jq ^https?://app\.bili(bili\.com|api\.net)/x/v2/splash/(brand/list|event/list2|list|show)(\?|$) 'if (.data | type) == "object" then (if .data | has("list") then .data.list = [] else . end) else . end'

